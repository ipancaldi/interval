---
/**
 * FrameworkDiagram — the orbit diagram that anchors the Framework /
 * "How Total Experience Design Delivers" section.
 *
 * Renders the canonical TXD Model artwork from
 * /assets/icons/TXD_Model_2.svg. Updating the diagram is now a matter
 * of replacing that asset.
 */
import { asset } from "@lib/asset";
---

<img
  class="te-model"
  src={asset("/assets/icons/TXD_Model_2.svg")}
  alt="The Total Experience Design model — four delivery phases (Human Foundation, Vision, Experience Master Plan and Realisation) orbit a continuous Prototyping cycle around four experience dimensions: Space, Technology, Brand & Digital and Content, with Time at the centre."
  width="687"
  height="586"
  loading="lazy"
/>

<style>
  .te-model {
    width: 100%;
    max-width: 560px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>
