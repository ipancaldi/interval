---
/**
 * ServiceModule — one full service offering on the Services page.
 *
 * Three optional list blocks: "What's Included" / "Key activities",
 * "Designed For", and "Outcomes". Plus an optional "Approach"
 * paragraph slot before the outcomes.
 *
 * Layout:
 *   [num + title] · [intro paragraphs]   ← top row, two-column
 *   [meta lists]                          ← grid of up to 3 lists
 *   [approach text]                       ← optional
 */

interface ListBlock {
  label: string;
  items: string[];
}

interface Props {
  num: string;          // "S / 01"
  name: string;         // "Interval Experience Safari"
  intro: string[];      // intro paragraphs
  whatsIncluded?: ListBlock;
  designedFor?: ListBlock;
  outcomes?: ListBlock;
  approach?: string[];  // optional "Approach" paragraphs at the end
}

const { num, name, intro, whatsIncluded, designedFor, outcomes, approach } = Astro.props;

const lists = [whatsIncluded, designedFor, outcomes].filter(Boolean) as ListBlock[];
---

<article class="module reveal">
  <header class="module__head">
    <div class="module__num">{num}</div>
    <h3 class="module__name">{name}</h3>
  </header>

  <div class="module__intro">
    {intro.map((p) => <p>{p}</p>)}
  </div>

  {lists.length > 0 && (
    <div class={`module__lists module__lists--${lists.length}`}>
      {lists.map((list) => (
        <div class="module__list">
          <div class="module__list-label">{list.label}</div>
          <ul role="list">
            {list.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  )}

  {approach && approach.length > 0 && (
    <div class="module__approach">
      <div class="module__list-label">Approach</div>
      {approach.map((p) => <p>{p}</p>)}
    </div>
  )}
</article>

<style>
  .module {
    padding: var(--section-pad) 0;
    border-top: var(--rule);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 48px);
  }
  @media (min-width: 900px) {
    .module { grid-template-columns: 1fr 1.5fr; }
  }

  .module__head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .module__num {
    font-size: var(--fs-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--fg-muted);
  }
  .module__name {
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    font-weight: 400;
    max-width: 14ch;
  }

  .module__intro {
    font-size: var(--fs-body);
    line-height: var(--lh-base);
    color: #1a1a1a;
    max-width: 60ch;
  }
  .module__intro :global(p + p) { margin-top: 1em; }

  /* Lists span both columns underneath the head+intro */
  .module__lists {
    grid-column: 1 / -1;
    display: grid;
    gap: clamp(24px, 3vw, 40px);
    padding-top: clamp(16px, 3vw, 32px);
    border-top: var(--rule);
  }
  @media (min-width: 720px) {
    .module__lists--2 { grid-template-columns: repeat(2, 1fr); }
    .module__lists--3 { grid-template-columns: repeat(3, 1fr); }
  }

  .module__list-label {
    font-size: var(--fs-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--fg-muted);
    margin-bottom: 14px;
  }
  .module__list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
    line-height: 1.55;
    color: #1a1a1a;
  }
  .module__list li {
    padding-top: 10px;
    margin-top: 10px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .module__list li:first-child { border-top: none; padding-top: 0; margin-top: 0; }

  .module__approach {
    grid-column: 1 / -1;
    padding-top: clamp(16px, 3vw, 32px);
    border-top: var(--rule);
    font-size: var(--fs-body);
    line-height: var(--lh-base);
    color: #1a1a1a;
    max-width: 72ch;
  }
  .module__approach :global(p + p) { margin-top: 1em; }
</style>
