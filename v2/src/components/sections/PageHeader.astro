---
/**
 * PageHeader — light editorial opener for pages that deliberately skip
 * the full-bleed dark point-cloud Hero (About, Journal).
 *
 * Sits on the light surface directly under the fixed nav (it owns the
 * top padding needed to clear it), so these pages read differently from
 * the landing pages while staying in the same typographic system.
 *
 * `title` accepts HTML so callers can place <em> on emphasised words.
 */

interface Props {
  eyebrowLeft: string;   // e.g. "IV005 — Journal"
  eyebrowRight: string;  // e.g. "Studio notes"
  title: string;         // HTML allowed (use <em> for emphasis)
  subtitle?: string;
}

const { eyebrowLeft, eyebrowRight, title, subtitle } = Astro.props;
---

<header class="page-header container" id="top">
  <div class="page-header__eyebrows">
    <span class="accent">{eyebrowLeft}</span>
    <span>{eyebrowRight}</span>
  </div>
  <h1 class="page-header__title" set:html={title}></h1>
  {subtitle && <p class="page-header__sub" set:html={subtitle}></p>}
</header>

<style>
  .page-header {
    /* Clear the fixed nav, then give the opener real breathing room. */
    padding-top: clamp(128px, 22vh, 216px);
    padding-bottom: clamp(40px, 6vw, 72px);
    border-bottom: var(--rule);
  }

  .page-header__eyebrows {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
    font-size: var(--fs-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--fg-muted);
    margin-bottom: clamp(28px, 5vw, 56px);
  }
  .page-header__eyebrows .accent { color: var(--accent-light); }

  .page-header__title {
    font-weight: 400;
    font-size: clamp(40px, 6.2vw, 88px);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    font-feature-settings: "ss01";
    max-width: 18ch;
    text-wrap: balance;
  }
  .page-header__title :global(em) { color: var(--accent-light); }

  .page-header__sub {
    margin-top: clamp(20px, 3vw, 32px);
    max-width: 48ch;
    font-size: var(--fs-body-lg);
    line-height: 1.45;
    color: #1a1a1a;
  }
</style>
