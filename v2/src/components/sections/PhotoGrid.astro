---
/**
 * PhotoGrid — flexible 2-up (or 3-up) tile grid for thematic imagery.
 * Hover scales tiles subtly.
 */

interface Tile {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  tiles: Tile[];
  columns?: 2 | 3;
}

const { tiles, columns = 2 } = Astro.props;
---

<section class={`photo-grid photo-grid--${columns} reveal`}>
  {tiles.map((tile) => (
    <figure class="photo-tile">
      <img src={tile.src} alt={tile.alt} loading="lazy" />
      {tile.caption && <figcaption class="photo-tile__caption">{tile.caption}</figcaption>}
    </figure>
  ))}
</section>

<style>
  .photo-grid {
    padding: calc(var(--section-pad) * 0.5) 0 var(--section-pad);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 24px);
  }
  @media (min-width: 720px) {
    .photo-grid--2 { grid-template-columns: 1fr 1fr; }
    .photo-grid--3 { grid-template-columns: 1fr 1fr 1fr; }
  }
  .photo-tile {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #ddd;
    margin: 0;
  }
  .photo-tile img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .photo-tile:hover img { transform: scale(1.04); }
  .photo-tile__caption {
    position: absolute;
    left: 16px; bottom: 14px;
    color: #fff;
    font-size: var(--fs-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
</style>
