---
/**
 * ServiceDetailHero
 *
 * Static half-height hero used on the per-service detail pages.
 * No point cloud, no interaction — instead a brand-coloured ground
 * with the geometric pattern.svg sitting in the foreground, tinted
 * via CSS mask. Each service passes its own background / pattern
 * colour combo so the five detail pages feel visually distinct.
 *
 * Props mirror the relevant subset of Hero.astro so callers can swap
 * between them with minimal change.
 */

import { asset } from "@lib/asset";

interface Props {
  eyebrowLeft: string;
  eyebrowRight: string;
  title: string;       // HTML allowed (use <em> for emphasis)
  subtitle?: string;
  /** Background colour of the hero block (brand hex). */
  bgColor: string;
  /** Pattern fill colour (brand hex). */
  patternColor: string;
  /** Foreground / text colour — pick black or off-white based on bgColor. */
  textColor?: string;
  /** Path to the pattern SVG used as a CSS mask. */
  patternSvg?: string;
  /** Optional photographic background. When set, the hero becomes a
   *  dark, editorial surface: the photo is washed in the brand colour
   *  and darkened with a scrim so off-white text + mint emphasis read
   *  cleanly, with the brand pattern still overlaid on the right. */
  image?: string;
  imageAlt?: string;
}

const {
  eyebrowLeft,
  eyebrowRight,
  title,
  subtitle,
  bgColor,
  patternColor,
  textColor = "#F9F9F3",
  patternSvg = asset("/assets/icons/pattern.svg"),
  image,
  imageAlt = "",
} = Astro.props;

const hasImage = Boolean(image);

// Over a photo the type is off-white with a coloured italic em. Enforce
// the rule that text and the foreground graphic (the pattern) never share
// a colour: if the pattern matches the off-white title it is nudged to
// mint, and the em is the first brand accent that differs from the pattern.
const OFF_WHITE = "#F9F9F3";
const WHITE = "#FFFFFF";
const MINT = "#82FFC0";
const BRICK = "#C05000";
const MAUVE = "#C8B4DC";
const sameHex = (a: string, b: string) => a.toLowerCase() === b.toLowerCase();

let patternFill = patternColor;
let emFill = patternColor; // non-photo default: em tracks the pattern colour
if (hasImage) {
  if (sameHex(patternFill, OFF_WHITE)) patternFill = MINT; // graphic ≠ off-white title
  // A mint graphic pairs with white emphasis; otherwise the first brand
  // accent that differs from the graphic.
  emFill = sameHex(patternFill, MINT)
    ? WHITE
    : [MINT, MAUVE, BRICK].find((c) => !sameHex(c, patternFill)) ?? MINT;
}

// Over a photo we always read as a dark surface (off-white text on a
// brand-washed, scrimmed image). Without a photo, fall back to the
// luminance heuristic on the brand background colour.
const surface: "dark" | "light" = hasImage
  ? "dark"
  : (() => {
      const hex = bgColor.replace("#", "");
      const r = parseInt(hex.slice(0, 2), 16);
      const g = parseInt(hex.slice(2, 4), 16);
      const b = parseInt(hex.slice(4, 6), 16);
      // perceived luminance
      const L = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
      return L < 0.6 ? "dark" : "light";
    })();
---

<header
  class:list={["sd-hero", { "sd-hero--photo": hasImage }]}
  data-surface={surface}
  id="top"
  style={`--sd-bg: ${bgColor}; --sd-pattern: ${patternFill}; --sd-em: ${emFill}; --sd-fg: ${textColor}; --sd-pattern-svg: url(${patternSvg});`}
>
  {hasImage && (
    <div class="sd-hero__media" aria-hidden="true">
      <img class="sd-hero__bg" src={image} alt={imageAlt} loading="eager" />
      <div class="sd-hero__tint"></div>
      <div class="sd-hero__scrim"></div>
    </div>
  )}

  <!-- Decorative pattern. CSS mask paints the SVG silhouette in
       --sd-pattern; the rest of the hero shows --sd-bg. -->
  <div class="sd-hero__pattern" aria-hidden="true"></div>

  <div class="container sd-hero__inner">
    <div class="sd-hero__head">
      <span>{eyebrowLeft}</span>
      <span>{eyebrowRight}</span>
    </div>

    <div class="sd-hero__main">
      <h1 class="sd-hero__title" set:html={title}></h1>
      {subtitle && <p class="sd-hero__sub">{subtitle}</p>}
    </div>
  </div>
</header>

<style>
  .sd-hero {
    position: relative;
    overflow: hidden;
    background: var(--sd-bg);
    color: var(--sd-fg);
    min-height: 50vh;
    display: flex;
    flex-direction: column;
  }

  /* ---- Photographic variant ---------------------------------------
     A layered stack sits behind the pattern + content:
       1. .sd-hero__bg     the photo (object-fit: cover)
       2. .sd-hero__tint   a brand-colour wash (multiply) for identity
       3. .sd-hero__scrim  a diagonal dark gradient so the left-anchored
                           title/eyebrow always have contrast
     Over a photo the type switches to off-white with a mint italic em,
     matching the brand's "mint emphasis on dark surfaces" rule. */
  .sd-hero__media { position: absolute; inset: 0; z-index: 0; }
  .sd-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sd-hero__tint {
    position: absolute;
    inset: 0;
    background: var(--sd-bg);
    mix-blend-mode: multiply;
    opacity: 0.38;
  }
  .sd-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.28) 42%,
        rgba(0, 0, 0, 0.04) 72%,
        rgba(0, 0, 0, 0.16) 100%),
      linear-gradient(0deg,
        rgba(0, 0, 0, 0.30) 0%,
        rgba(0, 0, 0, 0) 45%);
  }
  .sd-hero--photo { background: #111; color: #F9F9F3; min-height: 58vh; }
  .sd-hero--photo .sd-hero__title :global(em) { color: var(--sd-em); }
  .sd-hero--photo .sd-hero__head { opacity: 0.85; }
  .sd-hero--photo .sd-hero__sub { opacity: 0.95; }

  /* Pattern overlay — full-bleed, right-anchored so the title has
     breathing room on the left. Using CSS mask so the SVG silhouette
     can be tinted to any brand colour from CSS. */
  .sd-hero__pattern {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(60%, 720px);
    background: var(--sd-pattern);
    mask-image: var(--sd-pattern-svg);
    -webkit-mask-image: var(--sd-pattern-svg);
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-position: right center;
    -webkit-mask-position: right center;
    mask-size: contain;
    -webkit-mask-size: contain;
    opacity: 0.8;
    pointer-events: none;
  }

  .sd-hero__inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 96px;
    padding-bottom: 32px;
    gap: clamp(20px, 4vh, 36px);
  }

  .sd-hero__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    font-size: var(--fs-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    opacity: 0.7;
  }

  .sd-hero__main {
    max-width: 60%;
  }
  @media (max-width: 800px) {
    .sd-hero__main { max-width: 100%; }
    /* On mobile the foreground graphic stretches across the full bleed
       of the hero frame at full opacity, sitting behind the type. */
    .sd-hero__pattern {
      inset: 0;
      width: 100%;
      opacity: 0.8;
      mask-position: center;
      -webkit-mask-position: center;
      mask-size: cover;
      -webkit-mask-size: cover;
    }
  }

  .sd-hero__title {
    font-weight: 400;
    font-size: clamp(40px, 6vw, 88px);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    margin: 0;
  }
  .sd-hero__title :global(em) {
    /* On these heroes, em colour tracks the pattern to thread the
       composition together. */
    color: var(--sd-pattern);
    font-style: italic;
    font-weight: 400;
  }

  .sd-hero__sub {
    margin-top: clamp(16px, 2vh, 24px);
    max-width: 48ch;
    font-size: var(--fs-body-lg);
    line-height: 1.4;
    opacity: 0.92;
  }
</style>
