---
/**
 * ServiceDetailHero
 *
 * Static half-height hero used on the per-service detail pages.
 * A photographic background washed in the service's brand colour, with
 * the geometric pattern.svg sitting in the foreground as a full-bleed,
 * full-height graphic. No text — the hero is purely a visual band.
 *
 * Text-related props are still accepted (so callers don't need to
 * change) but are intentionally not rendered.
 */

import { asset } from "@lib/asset";

interface Props {
  eyebrowLeft?: string;
  eyebrowRight?: string;
  title?: string;
  subtitle?: string;
  /** Background colour of the hero block (brand hex). */
  bgColor: string;
  /** Pattern / foreground graphic fill colour (brand hex). */
  patternColor: string;
  /** Foreground / text colour (unused — kept for prop compatibility). */
  textColor?: string;
  /** Path to the pattern SVG used as a CSS mask. */
  patternSvg?: string;
  /** Optional photographic background. */
  image?: string;
  imageAlt?: string;
}

const {
  bgColor,
  patternColor,
  patternSvg = asset("/assets/icons/pattern.svg"),
  image,
  imageAlt = "",
} = Astro.props;

const hasImage = Boolean(image);

// Over a photo we always read as a dark surface (so the nav flips to its
// light treatment). Without a photo, fall back to a luminance heuristic
// on the brand background colour.
const surface: "dark" | "light" = hasImage
  ? "dark"
  : (() => {
      const hex = bgColor.replace("#", "");
      const r = parseInt(hex.slice(0, 2), 16);
      const g = parseInt(hex.slice(2, 4), 16);
      const b = parseInt(hex.slice(4, 6), 16);
      const L = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
      return L < 0.6 ? "dark" : "light";
    })();
---

<header
  class:list={["sd-hero", { "sd-hero--photo": hasImage }]}
  data-surface={surface}
  id="top"
  style={`--sd-bg: ${bgColor}; --sd-pattern: ${patternColor}; --sd-pattern-svg: url(${patternSvg});`}
>
  {hasImage && (
    <div class="sd-hero__media" aria-hidden="true">
      <img class="sd-hero__bg" src={image} alt={imageAlt} loading="eager" />
      <div class="sd-hero__tint"></div>
      <div class="sd-hero__scrim"></div>
    </div>
  )}

  <!-- Foreground graphic: full-bleed, full-height, 100% opacity. CSS
       mask paints the SVG silhouette in --sd-pattern over the photo. -->
  <div class="sd-hero__pattern" aria-hidden="true"></div>
</header>

<style>
  .sd-hero {
    position: relative;
    overflow: hidden;
    background: var(--sd-bg);
    min-height: 50vh;
    display: flex;
    flex-direction: column;
  }
  .sd-hero--photo { background: #111; min-height: 58vh; }

  /* ---- Photographic layers (behind the foreground graphic) --------
       1. .sd-hero__bg     the photo (object-fit: cover)
       2. .sd-hero__tint   a brand-colour wash (multiply) for identity
       3. .sd-hero__scrim  a soft dark gradient for depth */
  .sd-hero__media { position: absolute; inset: 0; z-index: 0; }
  .sd-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sd-hero__tint {
    position: absolute;
    inset: 0;
    background: var(--sd-bg);
    mix-blend-mode: multiply;
    opacity: 0.38;
  }
  .sd-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg,
        rgba(0, 0, 0, 0.40) 0%,
        rgba(0, 0, 0, 0.18) 45%,
        rgba(0, 0, 0, 0.04) 75%,
        rgba(0, 0, 0, 0.14) 100%),
      linear-gradient(0deg,
        rgba(0, 0, 0, 0.22) 0%,
        rgba(0, 0, 0, 0) 45%);
  }

  /* Foreground graphic — full-bleed, stretched to the full height of the
     hero frame, at full opacity. */
  .sd-hero__pattern {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--sd-pattern);
    mask-image: var(--sd-pattern-svg);
    -webkit-mask-image: var(--sd-pattern-svg);
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-position: center;
    mask-size: cover;
    -webkit-mask-size: cover;
    opacity: 1;
    pointer-events: none;
  }
</style>
