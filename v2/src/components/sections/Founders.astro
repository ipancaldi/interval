---
/**
 * Founders — founder biographies. Opens the About page.
 *
 * Renders a list of people (name, role, optional portrait, bio). Two
 * columns on desktop, stacked on mobile. Portraits are optional — a
 * bio without an image simply renders as text.
 *
 * Content lives in src/content/pages/about.md (data.founders), editable
 * via the CMS.
 */

import { asset } from "@lib/asset";

interface Person {
  name: string;
  role: string;
  image?: string;
  imageAlt?: string;
  bio: string[];
}

interface Props {
  label: string;
  title: string;   // HTML allowed (use <em> for emphasis)
  people: Person[];
}

const { label, title, people } = Astro.props;
---

<section class="container founders" id="founders">
  <header class="founders__head reveal">
    <div class="founders__label">{label}</div>
    <h2 class="founders__title" set:html={title}></h2>
  </header>

  <div class="founders__grid reveal">
    {people.map((person) => (
      <article class="founder">
        {person.image && (
          <figure class="founder__photo">
            <img
              src={asset(person.image)}
              alt={person.imageAlt ?? person.name}
              loading="lazy"
            />
          </figure>
        )}
        <h3 class="founder__name">{person.name}</h3>
        <p class="founder__role">{person.role}</p>
        <div class="founder__bio">
          {person.bio.map((para) => <p>{para}</p>)}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .founders { padding-top: clamp(40px, 6vw, 64px); }

  .founders__label {
    font-size: var(--fs-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--fg-muted);
    margin-bottom: 18px;
  }
  .founders__title {
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    max-width: 18ch;
    font-weight: 400;
  }
  .founders__title :global(em) { color: var(--accent-light); }

  .founders__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 6vw, 56px);
    padding: clamp(28px, 4vw, 48px) 0 var(--section-pad);
    margin-top: clamp(28px, 4vw, 44px);
    border-top: var(--rule);
  }
  @media (min-width: 800px) {
    .founders__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--col-gap);
    }
  }

  .founder__photo {
    margin: 0 0 clamp(18px, 2.5vw, 24px);
    width: 100%;
    max-width: 220px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
  }
  .founder__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .founder__name {
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    font-weight: 400;
  }
  .founder__role {
    margin-top: 8px;
    font-size: var(--fs-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--fg-muted);
  }
  .founder__bio {
    margin-top: clamp(16px, 2.2vw, 22px);
    font-size: var(--fs-body);
    line-height: var(--lh-base);
    color: #1a1a1a;
    max-width: 46ch;
  }
  .founder__bio :global(p + p) { margin-top: 1em; }
</style>
