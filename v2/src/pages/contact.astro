---
/**
 * Contact (/contact/)
 *
 * Editorial contact page. The primary action is a mailto: link; a
 * "Stay connected" newsletter sign-up sits below. (The sign-up button
 * is a mailto for now — wire it to an email provider when ready.)
 */

import Base from "@layouts/Base.astro";
import MetaRow from "@components/sections/MetaRow.astro";
import Button from "@components/ui/Button.astro";
import { getPage } from "@lib/content";

const page = await getPage("contact");
const d = page.data as { email: string };

const newsletterHref =
  `mailto:${d.email}?subject=Newsletter%20signup` +
  `&body=Please%20add%20me%20to%20the%20Interval%20newsletter.`;
---

<Base meta={page.meta}>

  <div class="light-block contact-page" data-surface="light">

    <section class="container">
      <MetaRow left="IV006" right="Contact" />

      <div class="contact reveal">
        <h2 class="contact__title">Get in touch.</h2>
        <div class="contact__lead">
          <p>We work with organisations shaping complex, future-focused experiences and spaces.</p>
          <p>If you'd like to learn more about Interval, discuss an opportunity or explore a potential collaboration, we'd love to hear from you.</p>
        </div>
        <div class="contact__action">
          <Button href={`mailto:${d.email}`} arrow={true}>{d.email}</Button>
        </div>
      </div>
    </section>

    <section class="container">
      <div class="stay reveal">
        <div class="stay__label">Stay connected</div>
        <div class="stay__body">
          <h3 class="stay__title">Stay connected.</h3>
          <p class="stay__text">Sign up to receive our newsletter with our latest thinking, research and new perspectives from Interval.</p>
          <div class="stay__action">
            <Button href={newsletterHref} variant="ghost" arrow={true}>Sign up</Button>
          </div>
        </div>
      </div>
    </section>

  </div>

</Base>

<style>
  .light-block { background: var(--bg); color: var(--fg); }

  /* No hero on Contact — push the first section below the fixed nav. */
  .contact-page { padding-top: clamp(96px, 14vh, 140px); }

  .contact {
    padding: var(--section-pad) 0;
    max-width: 64ch;
  }
  .contact__title {
    font-size: clamp(40px, 6vw, 88px);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    font-weight: 400;
    margin-bottom: clamp(24px, 4vw, 40px);
    text-wrap: balance;
  }
  .contact__lead {
    font-size: var(--fs-body-lg);
    line-height: 1.5;
    color: #1a1a1a;
    max-width: 52ch;
  }
  .contact__lead p + p { margin-top: 1em; }
  .contact__action { margin-top: clamp(28px, 4vw, 40px); }

  /* Stay connected — newsletter sign-up */
  .stay {
    padding: var(--section-pad) 0;
    border-top: var(--rule);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 3vw, 32px);
  }
  @media (min-width: 760px) {
    .stay { grid-template-columns: 200px minmax(0, 1fr); }
  }
  .stay__label {
    font-size: var(--fs-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    color: var(--fg-muted);
  }
  .stay__body { max-width: 52ch; }
  .stay__title {
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    font-weight: 400;
    margin-bottom: 16px;
  }
  .stay__text {
    font-size: var(--fs-body);
    line-height: var(--lh-base);
    color: #1a1a1a;
  }
  .stay__action { margin-top: 24px; }
</style>
