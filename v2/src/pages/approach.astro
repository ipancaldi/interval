---
/**
 * Approach (/approach/)
 *
 * Per the v2 wireframe:
 *   Hero
 *   → Closing the Gap with Total Experience Design
 *   → A Unique Experience (two-column body)
 *   → How Total Experience Design Delivers
 *     · intro paragraph
 *     · dimension tiles row (5 colored visuals)
 *     · framework wheel diagram
 *
 * Copy lives in src/content/pages/approach.md.
 */

import Base from "@layouts/Base.astro";
import Hero from "@components/sections/Hero.astro";
import MetaRow from "@components/sections/MetaRow.astro";
import Editorial from "@components/sections/Editorial.astro";
import SectionTitle from "@components/sections/SectionTitle.astro";
import FrameworkDiagram from "@components/diagrams/FrameworkDiagram.astro";
import DimensionsGrid from "@components/sections/DimensionsGrid.astro";
import PhotoBleed from "@components/sections/PhotoBleed.astro";
import { getPage } from "@lib/content";
import { asset } from "@lib/asset";
import type { DimensionKey } from "@typings/ui";

const page = await getPage("approach");
// Hidden in the CMS (visible: false) → serve the 404, don't render the page.
if (!page.visible) return Astro.rewrite("/404");
const d = page.data as {
  hero: { eyebrowLeft: string; eyebrowRight: string; title: string; subtitle: string };
  closing: { label: string; title: string; body: string[] };
  unique: { label: string; title: string; bodyLeft: string[]; bodyRight: string[] };
  delivers: { label: string; title: string; intro: string[] };
  pauseGap: {
    image: string;
    alt: string;
    topLeft?: string;
    topRight?: string;
    caption: string;
    metaRight?: string;
  };
  pauseHuman: {
    image: string;
    alt: string;
    topLeft?: string;
    topRight?: string;
    caption: string;
    metaRight?: string;
  };
};

interface DimensionRow {
  num: string;
  name: string;
  components: string[];
  visual: DimensionKey;
}

const dimensions: DimensionRow[] = [
  {
    num: "D / 01",
    name: "Space",
    visual: "spatial",
    components: [
      "Form & Volume",
      "Lighting",
      "Materials & Texture",
      "Zoning",
      "Adaptability",
      "Material Provenance & Circularity",
      "Accessibility & Flow",
    ],
  },
  {
    num: "D / 02",
    name: "Technology",
    visual: "technology",
    components: [
      "Video / Display Technology",
      "Audio",
      "Responsive Systems & Sensors",
      "Automation & Kinetics",
      "Environmental Control",
      "Connectivity",
    ],
  },
  {
    num: "D / 03",
    name: "Brand &amp; Digital",
    visual: "brand-digital",
    components: [
      "Identity Clarity",
      "Emotional Resonance",
      "Integration (Brand + Experience)",
      "Staff / Concierge Design",
      "App / Web",
      "Ticketing",
    ],
  },
  {
    num: "D / 04",
    name: "Content",
    visual: "content",
    components: [
      "Functional",
      "Promotional",
      "Art (spatial, non-advertising)",
      "Editorial",
      "Social & Participatory",
      "Real-Time / Live",
    ],
  },
  {
    num: "D / 05",
    name: "Time",
    visual: "time",
    components: [
      "Cycles & Seasons",
      "Day-parting & Use Cases",
      "Evolution Across Years",
      "Programming Rhythm",
      "Operational Tempo",
    ],
  },
];
---

<Base meta={page.meta}>

  <Hero
    eyebrowLeft={d.hero.eyebrowLeft}
    eyebrowRight={d.hero.eyebrowRight}
    title={d.hero.title}
    subtitle={d.hero.subtitle}
    theme="brick"
    startIndex={3}
  />

  <div class="light-block" data-surface="light">

    <!-- CLOSING THE GAP -->
    <section class="container">
      <MetaRow left={d.closing.label} right="Closing the gap" />
      <Editorial title={d.closing.title}>
        {d.closing.body.map((p) => <p>{p}</p>)}
      </Editorial>
    </section>

    <!-- EDITORIAL PAUSE — bridging strategy and execution -->
    <PhotoBleed
      src={asset(d.pauseGap.image)}
      alt={d.pauseGap.alt}
      topLeft={d.pauseGap.topLeft}
      topRight={d.pauseGap.topRight}
      caption={d.pauseGap.caption}
      metaRight={d.pauseGap.metaRight}
    />

    <!-- A UNIQUE EXPERIENCE -->
    <section class="container" id="unique">
      <SectionTitle
        label={d.unique.label}
        title={d.unique.title}
      />
      <div class="unique__columns reveal">
        <div class="unique__col">
          {d.unique.bodyLeft.map((p) => <p>{p}</p>)}
        </div>
        <div class="unique__col">
          {d.unique.bodyRight.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- EDITORIAL PAUSE — the human foundation -->
    <PhotoBleed
      src={asset(d.pauseHuman.image)}
      alt={d.pauseHuman.alt}
      topLeft={d.pauseHuman.topLeft}
      topRight={d.pauseHuman.topRight}
      caption={d.pauseHuman.caption}
      metaRight={d.pauseHuman.metaRight}
    />

    <!-- HOW TOTAL EXPERIENCE DESIGN DELIVERS -->
    <section class="container" id="delivers">
      <SectionTitle
        label={d.delivers.label}
        title={d.delivers.title}
      />

      <div class="delivers__intro reveal">
        {d.delivers.intro.map((p) => <p>{p}</p>)}
      </div>

      <!-- The model first — the framework wheel with its own title -->
      <div class="delivers__block delivers__block--model reveal">
        <h3 class="block-title">The Total Experience Design Model</h3>
        <FrameworkDiagram />
      </div>

      <!-- Then the dimensions that make up the model -->
      <div class="delivers__block reveal">
        <h3 class="block-title">The Experience Dimensions</h3>
        <DimensionsGrid items={dimensions} />
      </div>
    </section>

  </div>

</Base>

<style>
  .light-block { background: var(--bg); color: var(--fg); }

  .unique__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(24px, 4vw, 48px) 0 var(--section-pad);
    border-top: var(--rule);
    font-size: var(--fs-body);
    line-height: var(--lh-base);
    color: #1a1a1a;
  }
  @media (min-width: 800px) {
    .unique__columns { grid-template-columns: 1fr 1fr; }
  }
  .unique__col p + p { margin-top: 1em; }

  .delivers__intro {
    padding: clamp(8px, 2vw, 16px) 0 clamp(24px, 4vw, 40px);
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.35;
    letter-spacing: -0.005em;
    max-width: 64ch;
    color: #1a1a1a;
  }
  .delivers__intro p + p { margin-top: 0.7em; }

  .delivers__block {
    padding: clamp(28px, 4vw, 52px) 0;
    border-top: var(--rule);
  }
  .delivers__block:last-child { padding-bottom: var(--section-pad); }
  .block-title {
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    font-weight: 400;
    margin-bottom: clamp(20px, 3vw, 36px);
  }
  .delivers__block--model {
    display: flex;
    flex-direction: column;
  }
  .delivers__block--model :global(.te-model) { margin-top: clamp(8px, 2vw, 24px); }
</style>
