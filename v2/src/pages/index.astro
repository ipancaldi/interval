---
/**
 * Home (/)
 *
 * Composes the editorial sequence from the v2 wireframe:
 *   Hero
 *   → Designing for Adaptability (problem)
 *   → A New Model — Total Experience Design (solution + diagram)
 *   → Experience Outcomes (5 KSPs)
 *
 * Copy lives in src/content/pages/home.md.
 */

import Base from "@layouts/Base.astro";
import Hero from "@components/sections/Hero.astro";
import MetaRow from "@components/sections/MetaRow.astro";
import Editorial from "@components/sections/Editorial.astro";
import SectionTitle from "@components/sections/SectionTitle.astro";
import Button from "@components/ui/Button.astro";
import PhotoBleed from "@components/sections/PhotoBleed.astro";
import PrinciplesStrip from "@components/sections/PrinciplesStrip.astro";
import { getPage } from "@lib/content";
import { asset } from "@lib/asset";

const page = await getPage("home");
const d = page.data as {
  hero: {
    eyebrowLeft: string;
    eyebrowRight: string;
    title: string;
    subtitle: string;
    secondary: string;
  };
  problem: { label: string; title: string; body: string[] };
  newModel: {
    label: string;
    title: string;
    intro: string;
    exploreHref: string;
    exploreLabel: string;
    principles: { num: string; title: string; body: string }[];
  };
  outcomes: { label: string; heading: string };
};
---

<Base meta={page.meta}>

  <Hero
    eyebrowLeft={d.hero.eyebrowLeft}
    eyebrowRight={d.hero.eyebrowRight}
    title={d.hero.title}
    subtitle={`${d.hero.subtitle}<br /><br />${d.hero.secondary}`}
    cloudColor="#3D2EB8"
    startIndex={0}
  />

  <div class="light-block" data-surface="light">

    <!-- DESIGNING FOR ADAPTABILITY — the problem -->
    <section class="container" id="problem">
      <MetaRow left="IV001" right="Designing for Adaptability" />
      <Editorial title={d.problem.title}>
        {d.problem.body.map((p) => <p>{p}</p>)}
      </Editorial>
    </section>

    <!-- EDITORIAL PAUSE — adaptive spaces in the real world -->
    <PhotoBleed
      src={asset("/assets/images/editorial/home-adaptability.jpg")}
      alt="A commercial district at golden hour — people crossing an open plaza between mixed-use buildings."
      topLeft="FIG. 01 — Adaptive spaces, mixed-use"
      topRight="Spatial · Commercial"
      caption="One place, asked to be <em>many things</em> at once."
      metaRight="Total Experience Design"
    />

    <!-- A NEW MODEL — total experience design, with diagram + explore CTA -->
    <section class="container" id="new-model">
      <SectionTitle
        label={d.newModel.label}
        title={d.newModel.title}
      />

      <div class="new-model__lead reveal">
        <p class="new-model__intro">{d.newModel.intro}</p>
      </div>

      <ol class="principles-list reveal" role="list">
        {d.newModel.principles.map((p) => (
          <li class="principle-pt">
            <div class="principle-pt__num">{p.num}</div>
            <div class="principle-pt__body">
              <h3 class="principle-pt__title" set:html={p.title}></h3>
              <p class="principle-pt__text">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="new-model__explore reveal">
        <Button href={asset(d.newModel.exploreHref)} variant="ghost" arrow={true}>
          {d.newModel.exploreLabel}
        </Button>
      </div>
    </section>

    <!-- EXPERIENCE OUTCOMES — 5 KSP strip with heading -->
    <section id="outcomes">
      <div class="container">
        <MetaRow left={d.outcomes.label} right="Five outcomes" />
      </div>
      <PrinciplesStrip heading={d.outcomes.heading} />
    </section>

  </div>

</Base>

<style>
  .light-block { background: var(--bg); color: var(--fg); }

  .new-model__lead {
    padding: 0 0 clamp(24px, 4vw, 48px);
  }
  .new-model__intro {
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 56ch;
  }

  /* Four key points — numbered editorial rows that replace the old
     model diagram + two-column body. */
  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--rule);
  }
  .principle-pt {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px 0;
    padding: clamp(28px, 4vw, 48px) 0;
    border-bottom: var(--rule);
  }
  @media (min-width: 760px) {
    .principle-pt {
      grid-template-columns: 96px minmax(0, 1fr);
      column-gap: clamp(24px, 4vw, 56px);
      align-items: baseline;
    }
  }
  .principle-pt__num {
    font-size: clamp(15px, 1.2vw, 18px);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    color: var(--accent-light);
    font-feature-settings: "tnum";
  }
  .principle-pt__body { max-width: 60ch; }
  .principle-pt__title {
    font-size: clamp(26px, 3.2vw, 44px);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    font-weight: 400;
    margin-bottom: clamp(10px, 1.4vw, 18px);
    text-wrap: balance;
  }
  .principle-pt__title :global(em) {
    font-style: italic;
    color: var(--accent-light);
  }
  .principle-pt__text {
    font-size: var(--fs-body);
    line-height: var(--lh-base);
    color: #1a1a1a;
  }

  .new-model__explore {
    display: flex;
    padding-top: clamp(28px, 4vw, 48px);
    padding-bottom: var(--section-pad);
  }
</style>
